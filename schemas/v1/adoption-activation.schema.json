{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nextstep.local/schemas/v1/adoption-activation.schema.json",
  "title": "NextStep Adoption Activation Records 1.0",
  "oneOf": [
    { "$ref": "#/definitions/activation" },
    { "$ref": "#/definitions/receipt" },
    { "$ref": "#/definitions/rollbackReceipt" }
  ],
  "definitions": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "oid": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "repository_identity", "candidate_digest",
        "confirmation_envelope_digest", "baseline_oid", "genesis_oid", "control_parent_oid",
        "effect_identity", "activation_receipt_identity", "rollback_guard", "activated_at_trusted",
        "activation_digest"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "adoption-activation" },
        "repository_identity": { "$ref": "#/definitions/digest" },
        "candidate_digest": { "$ref": "#/definitions/digest" },
        "confirmation_envelope_digest": { "$ref": "#/definitions/digest" },
        "baseline_oid": { "$ref": "#/definitions/oid" },
        "genesis_oid": { "$ref": "#/definitions/oid" },
        "control_parent_oid": { "$ref": "#/definitions/oid" },
        "effect_identity": { "$ref": "#/definitions/digest" },
        "activation_receipt_identity": { "$ref": "#/definitions/digest" },
        "rollback_guard": {
          "type": "object", "additionalProperties": false,
          "required": ["expected_namespace_digest", "no_external_side_effects"],
          "properties": {
            "expected_namespace_digest": { "$ref": "#/definitions/digest" },
            "no_external_side_effects": { "const": true }
          }
        },
        "activated_at_trusted": { "$ref": "#/definitions/timestamp" },
        "activation_digest": { "$ref": "#/definitions/digest" }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "repository_identity", "effect_identity", "candidate_digest",
        "confirmation_envelope_digest", "formal_oid", "activation_oid", "genesis_oid", "activated_namespace_digest",
        "activated_at_trusted", "receipt_digest"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "adoption-activation-receipt" },
        "repository_identity": { "$ref": "#/definitions/digest" },
        "effect_identity": { "$ref": "#/definitions/digest" },
        "candidate_digest": { "$ref": "#/definitions/digest" },
        "confirmation_envelope_digest": { "$ref": "#/definitions/digest" },
        "formal_oid": { "$ref": "#/definitions/oid" },
        "activation_oid": { "$ref": "#/definitions/oid" },
        "genesis_oid": { "$ref": "#/definitions/oid" },
        "activated_namespace_digest": { "$ref": "#/definitions/digest" },
        "activated_at_trusted": { "$ref": "#/definitions/timestamp" },
        "receipt_digest": { "$ref": "#/definitions/digest" }
      }
    },
    "rollbackReceipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "repository_identity", "effect_identity",
        "activation_receipt_digest", "previous_namespace_digest", "rollback_action_digest",
        "rolled_back_at_trusted", "status", "receipt_digest"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "adoption-rollback-receipt" },
        "repository_identity": { "$ref": "#/definitions/digest" },
        "effect_identity": { "$ref": "#/definitions/digest" },
        "activation_receipt_digest": { "$ref": "#/definitions/digest" },
        "previous_namespace_digest": { "$ref": "#/definitions/digest" },
        "rollback_action_digest": { "$ref": "#/definitions/digest" },
        "rolled_back_at_trusted": { "$ref": "#/definitions/timestamp" },
        "status": { "const": "rolled-back" },
        "receipt_digest": { "$ref": "#/definitions/digest" }
      }
    }
  }
}
