{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nextstep.local/schemas/v1/interaction-prototype.schema.json",
  "title": "NextStep Interaction Prototype 1.0",
  "description": "载体无关原型契约：输入、回应、确认节点、阶段转换、异常、恢复入口与不可偏离项；内嵌 Product Definition 2.0 记录并以摘要绑定上游身份。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "project",
    "product_definition_id",
    "product_definition_digest",
    "product_definition",
    "prototype_id",
    "carrier_scope",
    "inputs",
    "responses",
    "confirmation_nodes",
    "stages",
    "stage_transitions",
    "exceptions",
    "invariants",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_type": { "const": "interaction-prototype" },
    "project": { "$ref": "#/definitions/project" },
    "product_definition_id": { "type": "string", "minLength": 1 },
    "product_definition_digest": { "$ref": "#/definitions/digest" },
    "product_definition": { "type": "object" },
    "prototype_id": { "type": "string", "minLength": 1 },
    "carrier_scope": {
      "enum": ["carrier-agnostic", "codex-dialogue-script", "web-ui-mainline"]
    },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/input" } },
    "responses": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/response" } },
    "confirmation_nodes": { "type": "array", "items": { "$ref": "#/definitions/confirmationNode" } },
    "stages": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/stage" } },
    "stage_transitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/stageTransition" } },
    "exceptions": { "type": "array", "items": { "$ref": "#/definitions/exception" } },
    "invariants": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/invariant" } },
    "status": { "const": "ready-for-signoff" }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "formal_baseline"],
      "properties": {
        "repository_id": { "$ref": "#/definitions/digest" },
        "formal_baseline": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "summary", "bound_stage"],
      "properties": {
        "input_id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "bound_stage": { "type": "string", "minLength": 1 }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_id", "summary", "triggered_by", "bound_stage"],
      "properties": {
        "response_id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "triggered_by": { "type": "string", "minLength": 1 },
        "bound_stage": { "type": "string", "minLength": 1 }
      }
    },
    "confirmationNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation_node_id", "stage", "summary", "confirmation_kind"],
      "properties": {
        "confirmation_node_id": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "confirmation_kind": { "const": "explicit-user-confirmation" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "name", "kind"],
      "properties": {
        "stage_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["initial", "working", "terminal"] }
      }
    },
    "stageTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_id", "from", "to", "trigger"],
      "properties": {
        "transition_id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "trigger": {
          "enum": ["user-action", "host-assembly", "kernel-validation", "explicit-confirmation"]
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exception_id", "stage", "summary"],
      "properties": {
        "exception_id": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "recovery": { "$ref": "#/definitions/recoveryEntry" }
      }
    },
    "recoveryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recovery_id", "target_stage", "summary"],
      "properties": {
        "recovery_id": { "type": "string", "minLength": 1 },
        "target_stage": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "source"],
      "properties": {
        "invariant_id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pointer", "value_digest"],
          "properties": {
            "pointer": { "type": "string" },
            "value_digest": { "$ref": "#/definitions/digest" }
          }
        }
      }
    }
  }
}
