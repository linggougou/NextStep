{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nextstep.local/schemas/v1/adoption-confirmation.schema.json",
  "title": "NextStep Trusted Adoption Confirmation Envelope 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "candidate_digest", "displayed_view_digest",
    "user_action_ref", "session_identity", "verifier_identity", "verified_at_trusted",
    "expires_at_trusted", "nonce_or_replay_key", "decision", "envelope_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_type": { "const": "adoption-confirmation-envelope" },
    "candidate_digest": { "$ref": "#/definitions/digest" },
    "displayed_view_digest": { "$ref": "#/definitions/digest" },
    "user_action_ref": { "$ref": "#/definitions/safeId" },
    "session_identity": { "$ref": "#/definitions/digest" },
    "verifier_identity": { "$ref": "#/definitions/safeId" },
    "verified_at_trusted": { "$ref": "#/definitions/timestamp" },
    "expires_at_trusted": { "$ref": "#/definitions/timestamp" },
    "nonce_or_replay_key": { "$ref": "#/definitions/safeId" },
    "decision": { "const": "confirm" },
    "envelope_digest": { "$ref": "#/definitions/digest" }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "safeId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
