{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nextstep.local/schemas/v1/requirement-freeze-command.schema.json",
  "title": "NextStep Requirement Freeze Command 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action", "requirement_set", "confirmation"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "action": { "const": "freeze-requirement-set" },
    "requirement_set": { "type": "object" },
    "confirmation": { "type": "object" },
    "known_frozen_records": { "type": "array", "items": { "type": "object" } }
  }
}
