{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nextstep.local/schemas/v1/adopted-baseline.schema.json",
  "title": "NextStep Adopted Baseline Record 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "repository_identity", "baseline_oid", "source_blobs",
    "candidate_digest", "confirmation_envelope_digest", "projected_stage", "projected_milestone",
    "projected_scope", "evidence_assessments", "unknown_gates", "disclaimer", "lifecycle_state",
    "record_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_type": { "const": "adopted-baseline" },
    "repository_identity": { "$ref": "#/definitions/digest" },
    "baseline_oid": { "$ref": "#/definitions/oid" },
    "source_blobs": { "type": "array", "minItems": 3, "maxItems": 18, "items": { "$ref": "#/definitions/sourceBlob" } },
    "candidate_digest": { "$ref": "#/definitions/digest" },
    "confirmation_envelope_digest": { "$ref": "#/definitions/digest" },
    "projected_stage": { "$ref": "#/definitions/safeText" },
    "projected_milestone": { "$ref": "#/definitions/safeText" },
    "projected_scope": { "$ref": "#/definitions/safeText" },
    "evidence_assessments": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/definitions/assessment" } },
    "unknown_gates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/safeText" } },
    "disclaimer": { "const": "adopted baseline; historical gates not verified by NextStep" },
    "lifecycle_state": { "enum": ["activated", "rollback-eligible", "rollback-blocked", "superseded"] },
    "record_digest": { "$ref": "#/definitions/digest" }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "oid": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "safeText": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9 ./_-]*$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "sourceBlob": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "blob_oid", "digest", "classification"],
      "properties": {
        "path": { "$ref": "#/definitions/relativePath" },
        "blob_oid": { "$ref": "#/definitions/oid" },
        "digest": { "$ref": "#/definitions/digest" },
        "classification": { "enum": ["user-declared", "unknown"] }
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "classification"],
      "properties": {
        "subject": { "$ref": "#/definitions/safeText" },
        "classification": { "enum": ["user-declared", "unknown"] }
      }
    }
  }
}
