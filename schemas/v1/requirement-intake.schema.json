{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nextstep.local/schemas/v1/requirement-intake.schema.json",
  "title": "NextStep Requirement Intake 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_expression",
        "intent_summary",
        "goals",
        "scenarios",
        "constraints",
        "expected_outputs",
        "non_goal_gaps",
        "clarification_gaps"
      ],
      "properties": {
        "raw_expression": {
          "type": "string",
          "minLength": 1
        },
        "intent_summary": {
          "$ref": "#/definitions/intentSummary"
        },
        "goals": {
          "$ref": "#/definitions/dimension"
        },
        "scenarios": {
          "$ref": "#/definitions/dimension"
        },
        "constraints": {
          "$ref": "#/definitions/dimension"
        },
        "expected_outputs": {
          "$ref": "#/definitions/dimension"
        },
        "non_goal_gaps": {
          "$ref": "#/definitions/dimension"
        },
        "clarification_gaps": {
          "$ref": "#/definitions/dimension"
        }
      }
    }
  },
  "definitions": {
    "intentSummary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "identified"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "missing"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "dimension": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "items"
          ],
          "properties": {
            "status": {
              "const": "identified"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "items"
          ],
          "properties": {
            "status": {
              "const": "missing"
            },
            "items": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      ]
    }
  }
}
