{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nextstep.local/schemas/v1/requirement-intake.schema.json",
  "title": "NextStep Requirement Intake 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_expression",
        "intent_summary",
        "goals",
        "scenarios",
        "constraints",
        "expected_outputs",
        "non_goal_gaps",
        "clarification_gaps"
      ],
      "properties": {
        "raw_expression": {
          "type": "string",
          "minLength": 1
        },
        "intent_summary": {
          "$ref": "#/definitions/intentSummary"
        },
        "goals": {
          "$ref": "#/definitions/dimension"
        },
        "scenarios": {
          "$ref": "#/definitions/dimension"
        },
        "constraints": {
          "$ref": "#/definitions/dimension"
        },
        "expected_outputs": {
          "$ref": "#/definitions/dimension"
        },
        "non_goal_gaps": {
          "$ref": "#/definitions/dimension"
        },
        "clarification_gaps": {
          "$ref": "#/definitions/dimension"
        }
      }
    }
  },
  "definitions": {
    "evidenceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "quote"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quotedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/evidenceSpan"
          }
        }
      }
    },
    "intentSummary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "source",
            "value",
            "evidence"
          ],
          "properties": {
            "status": {
              "const": "identified"
            },
            "source": {
              "enum": [
                "quoted",
                "derived"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/evidenceSpan"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "clarification_question"
          ],
          "properties": {
            "status": {
              "const": "missing"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "clarification_question": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "dimension": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "items"
          ],
          "properties": {
            "status": {
              "const": "identified"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/quotedFact"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "items",
            "clarification_question"
          ],
          "properties": {
            "status": {
              "const": "missing"
            },
            "items": {
              "type": "array",
              "maxItems": 0
            },
            "clarification_question": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
