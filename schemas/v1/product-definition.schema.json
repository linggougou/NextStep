{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nextstep.local/schemas/v1/product-definition.schema.json",
  "title": "NextStep Product Definition Candidate 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "product_definition_id", "frozen_requirement", "frozen_requirement_digest", "prd", "user_journey", "capability_map"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_type": { "const": "product-definition-candidate" },
    "product_definition_id": { "type": "string", "minLength": 1 },
    "frozen_requirement": { "type": "object" },
    "frozen_requirement_digest": { "$ref": "#/definitions/digest" },
    "prd": { "$ref": "#/definitions/prd" },
    "user_journey": { "$ref": "#/definitions/journey" },
    "capability_map": { "$ref": "#/definitions/capabilityMap" }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "value_digest"],
      "properties": {
        "pointer": { "type": "string", "pattern": "^/requirement_set/items/[0-9]+/values/[0-9]+$" },
        "value_digest": { "$ref": "#/definitions/digest" }
      }
    },
    "directFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "source"],
      "properties": {
        "kind": { "const": "direct" },
        "value": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/definitions/source" }
      }
    },
    "derivedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "derivation_summary", "source_refs"],
      "properties": {
        "kind": { "const": "derived" },
        "value": { "type": "string", "minLength": 1 },
        "derivation_summary": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } }
      }
    },
    "fact": { "oneOf": [{ "$ref": "#/definitions/directFact" }, { "$ref": "#/definitions/derivedFact" }] },
    "facts": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/fact" } },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement", "target", "evidence"],
      "properties": {
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "completion-transition" } }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic_source", "required_state"],
          "properties": {
            "semantic_source": { "$ref": "#/definitions/source" },
            "required_state": { "const": "completed" }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["journey_sequence", "transition_digest"],
          "properties": {
            "journey_sequence": { "type": "integer", "minimum": 1 },
            "transition_digest": { "$ref": "#/definitions/digest" }
          }
        }
      }
    },
    "prd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_name", "problem", "target_users", "goals", "scenarios", "scope", "non_goals", "success_metrics"],
      "properties": {
        "product_name": { "$ref": "#/definitions/fact" },
        "problem": { "$ref": "#/definitions/fact" },
        "target_users": { "$ref": "#/definitions/facts" },
        "goals": { "$ref": "#/definitions/facts" },
        "scenarios": { "$ref": "#/definitions/facts" },
        "scope": { "$ref": "#/definitions/facts" },
        "non_goals": { "$ref": "#/definitions/facts" },
        "success_metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/metric" } }
      }
    },
    "journeyStateChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "enum": ["not-started", "in-progress", "completed"] },
        "to": { "enum": ["not-started", "in-progress", "completed"] }
      }
    },
    "journeyStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "actor", "semantic_source", "action", "state_change", "outcome"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "actor": { "$ref": "#/definitions/fact" },
        "semantic_source": { "$ref": "#/definitions/source" },
        "action": { "enum": ["start", "complete"] },
        "state_change": { "$ref": "#/definitions/journeyStateChange" },
        "outcome": { "enum": ["not-started", "in-progress", "completed"] }
      }
    },
    "journey": { "type": "object", "additionalProperties": false, "required": ["product_definition_id", "steps"], "properties": { "product_definition_id": { "type": "string", "minLength": 1 }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/journeyStep" } } } },
    "capabilityMap": { "type": "object", "additionalProperties": false, "required": ["product_definition_id", "capabilities"], "properties": { "product_definition_id": { "type": "string", "minLength": 1 }, "capabilities": { "$ref": "#/definitions/facts" } } }
  }
}
