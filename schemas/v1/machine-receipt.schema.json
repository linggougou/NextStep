{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nextstep.local/schemas/v1/machine-receipt.schema.json",
  "title": "NextStep Machine Receipt 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "ok",
    "code",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "code": {
      "enum": [
        "CONTRACT_PROBE_SUCCEEDED",
        "CONTRACT_PROBE_REJECTED",
        "INVALID_JSON",
        "SENSITIVE_FIELD_DETECTED"
      ]
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "const": "CONTRACT_PROBE_SUCCEEDED"
          }
        }
      },
      "else": {
        "properties": {
          "code": {
            "enum": [
              "CONTRACT_PROBE_REJECTED",
              "INVALID_JSON",
              "SENSITIVE_FIELD_DETECTED"
            ]
          }
        }
      }
    }
  ]
}
