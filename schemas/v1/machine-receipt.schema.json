{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nextstep.local/schemas/v1/machine-receipt.schema.json",
  "title": "NextStep Machine Receipt 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "ok",
    "code",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "code": {
      "enum": [
        "CONTRACT_PROBE_SUCCEEDED",
        "CONTRACT_PROBE_REJECTED",
        "INVALID_JSON",
        "SENSITIVE_FIELD_DETECTED",
        "REQUIREMENT_INTAKE_ACCEPTED",
        "REQUIREMENT_INTAKE_REJECTED",
        "DEVELOPMENT_TASK_EMBEDDED",
        "REQUIREMENT_FREEZE_ACCEPTED",
        "REQUIREMENT_FREEZE_REJECTED",
        "REQUIREMENT_NOT_FROZEN",
        "CONFIRMATION_MISMATCH",
        "IDENTITY_CONFLICT",
        "PRODUCT_DEFINITION_ACCEPTED",
        "PRODUCT_DEFINITION_REJECTED"
      ]
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "code": {
                "const": "CONTRACT_PROBE_SUCCEEDED"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "canonical_json",
                  "digest",
                  "dry_run",
                  "schema_version"
                ],
                "properties": {
                  "canonical_json": {
                    "type": "string"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "dry_run": {
                    "type": "boolean"
                  },
                  "schema_version": {
                    "const": "1.0"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "REQUIREMENT_INTAKE_ACCEPTED"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "canonical_json",
                  "digest",
                  "requirement_intake",
                  "schema_version",
                  "user_output"
                ],
                "properties": {
                  "canonical_json": {
                    "type": "string"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "requirement_intake": {
                    "type": "object"
                  },
                  "schema_version": {
                    "const": "1.0"
                  },
                  "user_output": {
                    "type": "object"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "PRODUCT_DEFINITION_ACCEPTED"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "canonical_json",
                  "digest",
                  "product_definition",
                  "schema_version"
                ],
                "properties": {
                  "canonical_json": { "type": "string" },
                  "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                  "product_definition": { "type": "object" },
                  "schema_version": { "const": "2.0" }
                }
              }
            }
          }
          ,
          {
            "properties": {
              "code": {
                "const": "REQUIREMENT_FREEZE_ACCEPTED"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "canonical_json",
                  "digest",
                  "frozen_requirement",
                  "requirement_set",
                  "schema_version"
                ],
                "properties": {
                  "canonical_json": {
                    "type": "string"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "frozen_requirement": {
                    "type": "object"
                  },
                  "requirement_set": {
                    "type": "object"
                  },
                  "schema_version": {
                    "const": "1.0"
                  }
                }
              }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "code": {
            "enum": [
              "CONTRACT_PROBE_REJECTED",
              "INVALID_JSON",
              "SENSITIVE_FIELD_DETECTED",
              "REQUIREMENT_INTAKE_REJECTED",
              "DEVELOPMENT_TASK_EMBEDDED",
              "REQUIREMENT_FREEZE_REJECTED",
              "REQUIREMENT_NOT_FROZEN",
              "CONFIRMATION_MISMATCH",
              "IDENTITY_CONFLICT",
              "PRODUCT_DEFINITION_REJECTED"
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dry_run"
            ],
            "properties": {
              "dry_run": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  ]
}
