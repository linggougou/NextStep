{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nextstep.local/schemas/v1/confirmation-node.schema.json",
  "title": "NextStep Generic Confirmation Node 1.0",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/view" },
    { "$ref": "#/definitions/challenge" },
    { "$ref": "#/definitions/viewDisplay" },
    { "$ref": "#/definitions/userAction" },
    { "$ref": "#/definitions/envelope" },
    { "$ref": "#/definitions/result" }
  ],
  "definitions": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "oid": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id"],
      "properties": { "repository_id": { "$ref": "#/definitions/digest" } }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "before_digest", "after_digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\\u0000][^\u0000\\\\]*$" },
        "mode": { "enum": ["create", "update"] },
        "before_digest": {
          "oneOf": [ { "type": "null" }, { "$ref": "#/definitions/digest" } ]
        },
        "after_digest": { "$ref": "#/definitions/digest" }
      }
    },
    "bindingFields": {
      "type": "object",
      "properties": {
        "action": { "const": "write-candidate-changes" },
        "project": { "$ref": "#/definitions/project" },
        "project_context_digest": { "$ref": "#/definitions/digest" },
        "formal_baseline": { "$ref": "#/definitions/oid" },
        "working_baseline_digest": { "$ref": "#/definitions/digest" },
        "candidate_digest": { "$ref": "#/definitions/digest" },
        "confirmation_view_digest": { "$ref": "#/definitions/digest" },
        "confirmation_id": { "type": "string", "minLength": 1 }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "action", "project", "project_context_digest", "formal_baseline", "working_baseline_digest", "candidate_digest", "summary", "targets", "confirmation_id", "challenge_created_at", "expires_at"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "write-confirmation-view" },
        "action": { "const": "write-candidate-changes" },
        "project": { "$ref": "#/definitions/project" },
        "project_context_digest": { "$ref": "#/definitions/digest" },
        "formal_baseline": { "$ref": "#/definitions/oid" },
        "working_baseline_digest": { "$ref": "#/definitions/digest" },
        "candidate_digest": { "$ref": "#/definitions/digest" },
        "summary": { "type": "string", "minLength": 1 },
        "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/target" } },
        "confirmation_id": { "type": "string", "minLength": 1 },
        "challenge_created_at": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "action", "project", "project_context_digest", "formal_baseline", "working_baseline_digest", "candidate_digest", "confirmation_view", "confirmation_view_digest", "confirmation_id", "proposer_id", "created_at", "expires_at"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "write-confirmation-challenge" },
        "action": { "const": "write-candidate-changes" },
        "project": { "$ref": "#/definitions/project" },
        "project_context_digest": { "$ref": "#/definitions/digest" },
        "formal_baseline": { "$ref": "#/definitions/oid" },
        "working_baseline_digest": { "$ref": "#/definitions/digest" },
        "candidate_digest": { "$ref": "#/definitions/digest" },
        "confirmation_view": { "$ref": "#/definitions/view" },
        "confirmation_view_digest": { "$ref": "#/definitions/digest" },
        "confirmation_id": { "type": "string", "minLength": 1 },
        "proposer_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "viewDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "action", "project", "project_context_digest", "formal_baseline", "working_baseline_digest", "candidate_digest", "confirmation_view", "challenge", "challenge_digest", "confirmation_view_digest", "confirmation_id", "display_id", "displayed_at"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "write-confirmation-view-display" },
        "action": { "const": "write-candidate-changes" },
        "project": { "$ref": "#/definitions/project" },
        "project_context_digest": { "$ref": "#/definitions/digest" },
        "formal_baseline": { "$ref": "#/definitions/oid" },
        "working_baseline_digest": { "$ref": "#/definitions/digest" },
        "candidate_digest": { "$ref": "#/definitions/digest" },
        "confirmation_view": { "$ref": "#/definitions/view" },
        "challenge": { "$ref": "#/definitions/challenge" },
        "challenge_digest": { "$ref": "#/definitions/digest" },
        "confirmation_view_digest": { "$ref": "#/definitions/digest" },
        "confirmation_id": { "type": "string", "minLength": 1 },
        "display_id": { "type": "string", "minLength": 1 },
        "displayed_at": { "type": "string", "minLength": 1 }
      }
    },
    "userAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "action", "project", "project_context_digest", "formal_baseline", "working_baseline_digest", "candidate_digest", "challenge_digest", "challenge_created_at", "expires_at", "display_id", "display_digest", "displayed_at", "user_action_id", "event_source", "actor_id", "user_action", "occurred_at", "confirmation_view_digest", "confirmation_id"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "write-confirmation-action" },
        "action": { "const": "write-candidate-changes" },
        "project": { "$ref": "#/definitions/project" },
        "project_context_digest": { "$ref": "#/definitions/digest" },
        "formal_baseline": { "$ref": "#/definitions/oid" },
        "working_baseline_digest": { "$ref": "#/definitions/digest" },
        "candidate_digest": { "$ref": "#/definitions/digest" },
        "challenge_digest": { "$ref": "#/definitions/digest" },
        "challenge_created_at": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 },
        "display_id": { "type": "string", "minLength": 1 },
        "display_digest": { "$ref": "#/definitions/digest" },
        "displayed_at": { "type": "string", "minLength": 1 },
        "user_action_id": { "type": "string", "minLength": 1 },
        "event_source": { "const": "independent-user-action" },
        "actor_id": { "type": "string", "minLength": 1 },
        "user_action": { "enum": ["confirm", "reject", "cancel"] },
        "occurred_at": { "type": "string", "minLength": 1 },
        "confirmation_view_digest": { "$ref": "#/definitions/digest" },
        "confirmation_id": { "type": "string", "minLength": 1 }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "action", "project", "project_context_digest", "formal_baseline", "working_baseline_digest", "candidate_digest", "challenge", "challenge_digest", "display", "display_digest", "user_action", "user_action_digest", "confirmation_kind", "confirmed_at", "confirmation_view_digest", "confirmation_id"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "write-confirmation-envelope" },
        "action": { "const": "write-candidate-changes" },
        "project": { "$ref": "#/definitions/project" },
        "project_context_digest": { "$ref": "#/definitions/digest" },
        "formal_baseline": { "$ref": "#/definitions/oid" },
        "working_baseline_digest": { "$ref": "#/definitions/digest" },
        "candidate_digest": { "$ref": "#/definitions/digest" },
        "challenge": { "$ref": "#/definitions/challenge" },
        "challenge_digest": { "$ref": "#/definitions/digest" },
        "display": { "$ref": "#/definitions/viewDisplay" },
        "display_digest": { "$ref": "#/definitions/digest" },
        "user_action": { "$ref": "#/definitions/userAction" },
        "user_action_digest": { "$ref": "#/definitions/digest" },
        "confirmation_kind": { "const": "explicit-user-confirmation" },
        "confirmed_at": { "type": "string", "minLength": 1 },
        "confirmation_view_digest": { "$ref": "#/definitions/digest" },
        "confirmation_id": { "type": "string", "minLength": 1 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "action", "project", "project_context_digest", "formal_baseline", "working_baseline_digest", "candidate_digest", "confirmation_view_digest", "confirmation_id", "envelope_digest", "transaction_result_digest", "result_id", "status", "recorded_at"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "write-confirmation-result" },
        "action": { "const": "write-candidate-changes" },
        "project": { "$ref": "#/definitions/project" },
        "project_context_digest": { "$ref": "#/definitions/digest" },
        "formal_baseline": { "$ref": "#/definitions/oid" },
        "working_baseline_digest": { "$ref": "#/definitions/digest" },
        "candidate_digest": { "$ref": "#/definitions/digest" },
        "confirmation_view_digest": { "$ref": "#/definitions/digest" },
        "confirmation_id": { "type": "string", "minLength": 1 },
        "envelope_digest": { "$ref": "#/definitions/digest" },
        "transaction_result_digest": { "$ref": "#/definitions/digest" },
        "result_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["committed", "blocked"] },
        "recorded_at": { "type": "string", "minLength": 1 }
      }
    }
  }
}
