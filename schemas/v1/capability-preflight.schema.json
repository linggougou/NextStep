{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nextstep.local/schemas/v1/capability-preflight.schema.json",
  "title": "NextStep Capability Preflight",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/evidence" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "oid": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "safeId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "host_version", "permission_configuration_id", "repository_id", "worktree_id", "formal_oid", "control_oid"],
      "properties": {
        "host_id": { "$ref": "#/$defs/safeId" },
        "host_version": { "$ref": "#/$defs/safeId" },
        "permission_configuration_id": { "$ref": "#/$defs/safeId" },
        "repository_id": { "$ref": "#/$defs/digest" },
        "worktree_id": { "$ref": "#/$defs/digest" },
        "formal_oid": { "$ref": "#/$defs/oid" },
        "control_oid": { "$ref": "#/$defs/oid" }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_project", "workspace_roots", "explicit_project_root", "expected_start_oid", "external_evidence_root"],
      "properties": {
        "requested_project": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
        "workspace_roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/" }
        },
        "explicit_project_root": { "type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/" },
        "expected_start_oid": { "$ref": "#/$defs/oid" },
        "external_evidence_root": { "type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "expected_binding", "probe", "validity_seconds"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "capability-preflight-request" },
        "expected_binding": { "$ref": "#/$defs/binding" },
        "probe": { "$ref": "#/$defs/probe" },
        "validity_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" }
    },
    "hostEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "host_id", "host_version", "permission_configuration_id", "stable_task_id_digest", "automatic_lifecycle", "checks", "blockers", "attestation_digest"],
      "properties": {
        "status": { "enum": ["passed", "blocked"] },
        "host_id": { "$ref": "#/$defs/safeId" },
        "host_version": { "$ref": "#/$defs/safeId" },
        "permission_configuration_id": { "$ref": "#/$defs/safeId" },
        "stable_task_id_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "automatic_lifecycle": { "type": "boolean" },
        "checks": { "$ref": "#/$defs/stringSet" },
        "blockers": { "$ref": "#/$defs/stringSet" },
        "attestation_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "projectEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "repository_id", "worktree_id", "formal_oid", "control_oid", "start_oid", "start_state", "content_identity", "atomic_create_or_return", "automatic_archive", "checks", "blockers", "attestation_digest"],
      "properties": {
        "status": { "enum": ["passed", "blocked"] },
        "repository_id": { "$ref": "#/$defs/digest" },
        "worktree_id": { "$ref": "#/$defs/digest" },
        "formal_oid": { "$ref": "#/$defs/oid" },
        "control_oid": { "$ref": "#/$defs/oid" },
        "start_oid": { "$ref": "#/$defs/oid" },
        "start_state": { "enum": ["clean", "staged", "unstaged", "untracked", "ignored", "mixed"] },
        "content_identity": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "atomic_create_or_return": { "type": "boolean" },
        "automatic_archive": { "type": "boolean" },
        "checks": { "$ref": "#/$defs/stringSet" },
        "blockers": { "$ref": "#/$defs/stringSet" },
        "attestation_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "preflight_id", "mode", "binding", "observed_at", "expires_at", "stages", "blockers", "next_action", "evidence_digest"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "capability-preflight-evidence" },
        "preflight_id": { "type": "string", "pattern": "^cp-[a-f0-9]{64}$" },
        "mode": { "enum": ["full", "manual-isolated", "blocked"] },
        "binding": { "$ref": "#/$defs/binding" },
        "observed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
        "expires_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host_bootstrap", "project_probe"],
          "properties": {
            "host_bootstrap": { "$ref": "#/$defs/hostEvidence" },
            "project_probe": { "oneOf": [{ "$ref": "#/$defs/projectEvidence" }, { "type": "null" }] }
          }
        },
        "blockers": { "$ref": "#/$defs/stringSet" },
        "next_action": { "enum": ["automatic-dispatch-eligible", "request-manual-isolated-task", "stop-and-reprobe"] },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
