{
  "name": "nextstep",
  "version": "0.2.0-alpha",
  "private": true,
  "description": "AI project delivery loop with document and Git-backed sources of truth.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "nextstep": "dist/src/cli/nextstep.js"
  },
  "files": [
    "dist/src/adapters/**/*.js",
    "dist/src/domain/**/*.js",
    "dist/src/cli/nextstep.js",
    "dist/src/cli/project-status.js",
    "dist/src/cli/requirement-intake.js",
    "dist/src/cli/requirement-freeze.js",
    "dist/src/cli/product-definition.js",
    "dist/src/cli/interaction-prototype.js",
    "dist/src/cli/carrier-decision.js",
    "dist/src/cli/acceptance-profile.js",
    "dist/src/cli/write-consistency.js",
    "dist/src/cli/source-validate.js",
    "dist/src/cli/version-chain.js",
    "dist/src/cli/major-milestone.js",
    "dist/src/cli/small-milestone.js",
    "dist/src/cli/execution-packet.js",
    "dist/schemas/v1/**/*.json",
    "dist/schemas/v2/product-definition.schema.json",
    "skills/nextstep/SKILL.md",
    "skills/nextstep/agents/openai.yaml",
    "README.md",
    "examples/quickstart/version-chain.json",
    "docs/releases/v0.2.0-alpha.md"
  ],
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/tests/**/*.test.js",
    "test:coverage": "pnpm build && node --test --experimental-test-coverage --test-coverage-include='dist/src/**/*.js' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 dist/tests/**/*.test.js",
    "check": "pnpm typecheck && pnpm test:coverage"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "es-module-lexer": "2.3.1",
    "typescript": "7.0.2"
  }
}
